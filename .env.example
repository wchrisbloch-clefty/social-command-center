# AetherHub — environment variables
#
# Copy to .env.local for local development. .env* is gitignored; this file is
# the only one committed, and it must never contain a real value.
#
# Every variable below is read somewhere in this repo. If you add a
# `process.env.X` anywhere, add it here in the same commit — this file is the
# canonical list, and the naming incident it exists to prevent is described
# under GOOGLE_AI_API_KEY.


# ── AI providers ──────────────────────────────────────────────────────────────
#
# app/api/brief/route.js tries these in order and returns the first that
# answers: Groq → Gemini → Claude. All three are optional and the app runs with
# none of them — the AI panels just report that no provider is configured.
#
# The order is a cost decision, not a quality one: the first two have free
# tiers and Claude is paid. The UI shows which one answered ("via Groq"), so a
# silent demotion to the paid tier is visible rather than something you find on
# a bill.

# Groq. First choice, free tier. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini. Second choice, free tier. https://aistudio.google.com/apikey
#
# GOOGLE_AI_API_KEY IS THE ONLY ACCEPTED NAME. It previously also answered to
# GOOGLE_AI_KEY and GEMINI_API_KEY; both were removed, because three names for
# one key meant a missing credential could look like three different problems.
#
# This exact spelling is not a preference — the vendored skills pick it.
# .agents/social-media-skills (reels-scripting, post-scorer) read
# GOOGLE_AI_API_KEY and are upstream repos we do not control, so the app
# conforms to them rather than the reverse. Do not rename it.
GOOGLE_AI_API_KEY=

# Anthropic Claude. Last resort, PAID. https://console.anthropic.com/settings/keys
# If the UI shows "via Claude" when you expected "via Groq" or "via Gemini",
# one of the two above is missing or wrong.
ANTHROPIC_API_KEY=


# ── Social ingestion ──────────────────────────────────────────────────────────
#
# RSSHub (github.com/DIYgod/RSSHub) turns Instagram, LinkedIn and X into RSS
# feeds. app/api/social/route.js reads this base URL and joins every RELATIVE
# route in config/sources.js onto it. Reddit sources use absolute URLs and never
# touch RSSHub — Reddit serves native RSS itself.
#
# Optional. Unset, the app uses the free public instance below.
#
#   Start here (free, shared, heavily rate-limited):
#     RSSHUB_BASE_URL=https://rsshub.app
#
#   Self-hosted later — change this ONE value, no code edits:
#     RSSHUB_BASE_URL=https://rsshub.your-domain.com
#
# Why you will end up self-hosting: the public instance is rate-limited and
# cannot serve routes that need credentials. /twitter/* requires a
# TWITTER_AUTH_TOKEN configured ON THE RSSHUB INSTANCE, and /instagram/* is
# flagged antiCrawler. LinkedIn company posts need no config and are the most
# likely to work on the free tier. See README §Social ingestion.
RSSHUB_BASE_URL=https://rsshub.app

# Extra hosts to rate-limit, as "host=ms" pairs, comma separated. Reddit is
# already paced at 1100ms by default (see app/api/social/route.js) — this is for
# a self-hosted RSSHub you would rather not hammer, and for pointing the
# rate-limit test at a fixture.
#   SOCIAL_THROTTLE_HOSTS=rsshub.internal=500
SOCIAL_THROTTLE_HOSTS=

# How long /api/social may spend before returning what it has. Reddit pacing
# makes a cold full feed ~20s; this bounds it so a slow host degrades a few
# sources instead of killing the whole response. Default 20000.
SOCIAL_DEADLINE_MS=

# YouTube Data API v3. YouTube deliberately does NOT go through RSSHub — it has
# a real API that returns view counts, and it is the only source whose signal
# scoring uses actual engagement rather than recency.
# https://console.cloud.google.com/apis/credentials
#
# Optional. Without it /api/youtube returns { needsKey: true, items: [] } and the
# rest of the feed renders normally.
YOUTUBE_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
#
# Not required yet. Nothing in the app imports the voice store — only
# scripts/sync-voice.mjs does. Needed for Step 3 (Settings → Voice).

# Vercel Postgres pooled connection string. DATABASE_URL is accepted as a
# fallback for non-Vercel hosts. Vercel → Storage → Postgres → .env.local.
#
# Prefer the DIRECT (unpooled) string for `npm run voice:sync`, which runs DDL.
# See SETUP.md §3 for the transaction-pooling risk this avoids.
POSTGRES_URL=
DATABASE_URL=

# Postgres for the integration tests ONLY. Deliberately a separate name:
# packages/voice-profile/test/postgres-integration.test.ts creates and DROPS
# tables, so it must never be able to reach a real database by accident.
# `npm test` skips those 8 tests when this is unset; `npm run test:pg` runs them.
#
#   docker run --rm -e POSTGRES_HOST_AUTH_METHOD=trust -p 5432:5432 postgres:16
POSTGRES_TEST_URL=


# ── Skills (not read by the app) ──────────────────────────────────────────────
#
# Required only by vendored skills in .agents/social-media-skills when you run
# them from a Claude Code session. The web app never reads these.

# Apify — Instagram scraping for reels-scripting, LinkedIn history for
# post-scorer. https://console.apify.com/account/integrations
APIFY_API_TOKEN=
