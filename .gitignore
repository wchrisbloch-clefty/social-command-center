# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the canonical list of what the app reads
# and must contain no real values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# voice-profile build artifacts — generated from the app database, one-way.
# The app is canonical; these are overwritten by `npm run voice:sync`.
/about-me.md
/voice.md
