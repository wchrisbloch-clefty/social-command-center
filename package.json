{
  "name": "aetherhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test packages/voice-profile/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "voice:sync": "node scripts/sync-voice.mjs",
    "test:pg": "node --test packages/voice-profile/test/postgres-integration.test.ts",
    "probe:rsshub": "node scripts/probe-rsshub.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "sources:map": "node scripts/build-source-map.mjs",
    "categories:verify": "node scripts/verify-categories.mjs",
    "verify:pacing": "node scripts/verify-reddit-pacing.mjs",
    "sources:resolve": "node scripts/resolve-sources.mjs",
    "podcasts:verify": "node scripts/verify-podcasts.mjs",
    "tune:throttle": "node scripts/tune-throttle.mjs",
    "verify:throughput": "node scripts/verify-throughput.mjs",
    "verify:swr": "node scripts/verify-swr.mjs",
    "audit:skeletons": "AUDIT_LOADING=1 node scripts/responsive-audit.mjs",
    "verify:charts": "node scripts/verify-charts.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
